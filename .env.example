# Copy to .env.local and fill in. Never commit .env.local.

# Supabase project (Project Settings > API Keys)
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=

# Server-only key for trusted jobs (points finalising, push sending). Never expose to the browser.
SUPABASE_SECRET_KEY=

# Public origin, e.g. http://localhost:3000 locally, https://games.seesunilag.com in production
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# Web Push (generate once with: pnpm dlx web-push generate-vapid-keys)
NEXT_PUBLIC_VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=

# Secret for /api/cron/notifications: Supabase's every-minute job sends it (Vault: notify_cron_secret).
# Generate one: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
CRON_SECRET=
